{
  "name": "Tokat DÇ — 1 WhatsApp Sorgulama Botu",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "tokat-whatsapp",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wf1-node-01",
      "name": "Webhook Doğrulama (GET)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-360, -120],
      "webhookId": "tokat-whatsapp-verify",
      "notes": "Meta panelde Callback URL doğrulaması bu GET isteğini gönderir."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.query['hub.verify_token'] }}",
              "rightValue": "={{ $env.WA_VERIFY_TOKEN }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        },
        "options": {}
      },
      "id": "wf1-node-02",
      "name": "Verify Token Doğru mu?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-140, -120]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $('Webhook Doğrulama (GET)').item.json.query['hub.challenge'] }}",
        "options": {}
      },
      "id": "wf1-node-03",
      "name": "Challenge Döndür (200)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [120, -220]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseCode": 403,
        "responseBody": "Forbidden",
        "options": {}
      },
      "id": "wf1-node-04",
      "name": "Reddet (403)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [120, -20]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "tokat-whatsapp",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wf1-node-05",
      "name": "Webhook Mesaj (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-360, 200],
      "webhookId": "tokat-whatsapp-msg",
      "notes": "Meta gelen her mesajı ve durum callback'ini buraya POST eder."
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "OK",
        "options": {}
      },
      "id": "wf1-node-06",
      "name": "Hemen 200 Dön",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [-140, 200],
      "notes": "Meta 200'ü hızlı bekler; iş akışına paralel devam eder."
    },
    {
      "parameters": {
        "jsCode": "// Meta WhatsApp payload'ından ilk mesajı çıkar\nconst body = $input.first().json.body || $input.first().json;\nconst entry = (body.entry && body.entry[0]) || {};\nconst change = (entry.changes && entry.changes[0]) || {};\nconst value = change.value || {};\nconst msg = (value.messages && value.messages[0]) || null;\n\n// Mesaj yoksa (ör. teslim/okundu durum callback'i) akışı durdur\nif (!msg || msg.type !== 'text') {\n  return [];\n}\n\nconst contact = (value.contacts && value.contacts[0]) || {};\nreturn [{\n  json: {\n    from: msg.from,                       // müşteri telefon numarası\n    name: contact.profile ? contact.profile.name : '',\n    text: msg.text ? msg.text.body : '',\n    message_id: msg.id,\n    phone_number_id: value.metadata ? value.metadata.phone_number_id : ''\n  }\n}];"
      },
      "id": "wf1-node-07",
      "name": "Mesajı Ayıkla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [80, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/whatsapp/handle",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-API-Key", "value": "={{ $env.BACKEND_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: $json.from, name: $json.name, text: $json.text }) }}",
        "options": {}
      },
      "id": "wf1-node-08",
      "name": "Backend: Sorguyu Yanıtla",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [300, 200],
      "notes": "Backend intent'i çözer (sefer/fiyat/koltuk/ürün) ve { reply } döndürür."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $env.WA_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.WA_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $('Mesajı Ayıkla').item.json.from, type: 'text', text: { preview_url: false, body: ($json.reply || 'Merhaba! Size nasıl yardımcı olabilirim? Sefer, fiyat, koltuk veya ürün sorabilirsiniz.') } }) }}",
        "options": {}
      },
      "id": "wf1-node-09",
      "name": "WhatsApp Yanıt Gönder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 200]
    }
  ],
  "connections": {
    "Webhook Doğrulama (GET)": { "main": [[{ "node": "Verify Token Doğru mu?", "type": "main", "index": 0 }]] },
    "Verify Token Doğru mu?": { "main": [[{ "node": "Challenge Döndür (200)", "type": "main", "index": 0 }], [{ "node": "Reddet (403)", "type": "main", "index": 0 }]] },
    "Webhook Mesaj (POST)": { "main": [[{ "node": "Hemen 200 Dön", "type": "main", "index": 0 }, { "node": "Mesajı Ayıkla", "type": "main", "index": 0 }]] },
    "Mesajı Ayıkla": { "main": [[{ "node": "Backend: Sorguyu Yanıtla", "type": "main", "index": 0 }]] },
    "Backend: Sorguyu Yanıtla": { "main": [[{ "node": "WhatsApp Yanıt Gönder", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "tags": ["tokat-dijital-carsi", "whatsapp"]
}
